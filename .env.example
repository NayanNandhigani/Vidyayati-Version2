# Copy this file to .env and fill in real values. Never commit .env.
#
# This project is cloud-only: there is no local-database mode. Point
# DATABASE_URL at a real cloud Postgres instance even for local dev — a
# free/dev-tier database on Neon, Railway Postgres, or Supabase all work
# unchanged (see Deployment.md for setup steps for each).

# PostgreSQL connection string for Prisma.
DATABASE_URL=""

# NextAuth — generate a secret with `openssl rand -base64 32`
AUTH_SECRET=""

# --- File storage (AWS S3) ---------------------------------------------
# Every uploaded file (ID photos, certificates, documents, ID-card
# assets, ...) is stored here — see lib/storage.ts.
AWS_REGION="ap-south-1"
AWS_S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Optional — only set this to point at an S3-compatible provider other
# than AWS (e.g. Cloudflare R2, or MinIO for local testing). Leave unset
# for real AWS S3.
# S3_ENDPOINT=""

# --- First-run bootstrap -------------------------------------------------
# There is no seed data. scripts/bootstrap-admin.ts (`npm run
# bootstrap-admin`) creates the very first Super Admin account using
# these — run it once, after the first `prisma migrate deploy`, then you
# can remove/rotate them. See Deployment.md.
BOOTSTRAP_ADMIN_USERNAME=""
BOOTSTRAP_ADMIN_NAME=""
BOOTSTRAP_ADMIN_EMAIL=""

# Left for when payments/WhatsApp integration comes off hold (see
# claude.md "On hold" section) — not needed for the initial build.
# RAZORPAY_KEY_ID=""
# RAZORPAY_KEY_SECRET=""
# WHATSAPP_API_TOKEN=""
